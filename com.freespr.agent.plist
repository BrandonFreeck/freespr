<?xml version="1.0" encoding="UTF-8"?>
<!--
  Non-authoritative reference only. `freespr init` GENERATES the live plist from scratch in code
  (Lifecycle.writeLaunchAgent) at ~/Library/LaunchAgents/com.freespr.agent.plist with the real
  binary path + home dir — it does NOT read or substitute this file, so editing the __BIN__/__HOME__
  placeholders below changes nothing. This copy only documents the shape: ProcessType=Interactive
  so the HID event tap isn't throttled (NOT Background); RunAtLoad + KeepAlive = always-on at login.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.freespr.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BIN__</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/freespr.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/freespr.log</string>
</dict>
</plist>
